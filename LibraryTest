					btn.Text = key
					waiting = false
					tween(btn:FindFirstChildOfClass("UIStroke"), 0.15, { Color = Theme.ElementStroke, Transparency = 0.4 })
					if d.CallOnChange and d.Callback then pcall(d.Callback, key) end
