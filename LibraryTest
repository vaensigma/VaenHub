			new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
			new("UIPadding", {
				PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
				PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16),
			}),
		})
		tab.Page = page

