				and input.UserInputType == Enum.UserInputType.Keyboard
				and not d.CallOnChange then
					if Enum.KeyCode[d.CurrentKeybind] and input.KeyCode == Enum.KeyCode[d.CurrentKeybind] then
						if d.Callback then pcall(d.Callback) end
					end
				end
			end)
			table.insert(keybindConns, conn)
			local proxy = { Type = "Keybind", Flag = d.Flag, Name = d.Name }
			setmetatable(proxy, { __index = function(_, k) if k == "CurrentKeybind" then return d.CurrentKeybind end end })
