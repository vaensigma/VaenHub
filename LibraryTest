function VaenLib:Notify(data)
	task.spawn(function()
		local notif = new("Frame", {
			Parent = NotifContainer,
			BackgroundColor3 = SelectedTheme.Notification,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			ClipsDescendants = true,
		}, {
			corner(8),
			stroke(SelectedTheme.ElementStroke, 1),
			padding(12),
		})

		local accent = new("Frame", {
			Parent = notif,
			BackgroundColor3 = SelectedTheme.Accent,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, -12, 0, 0),
			Size = UDim2.new(0, 3, 1, 0),
		})

		local layout = new("UIListLayout", {
			Parent = notif,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 4),
		})

		local title = new("TextLabel", {
			Parent = notif,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 18),
			Font = Enum.Font.GothamSemibold,
			Text = data.Title or "Notification",
			TextColor3 = SelectedTheme.Text,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTransparency = 1,
		})

		local content = new("TextLabel", {
			Parent = notif,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Font = Enum.Font.Gotham,
			Text = data.Content or "",
			TextColor3 = SelectedTheme.TextDim,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			TextTransparency = 1,
		})

		-- Animate in
		tween(notif, 0.3, { BackgroundTransparency = 0 })
		tween(notif:FindFirstChildOfClass("UIStroke"), 0.3, { Transparency = 0.6 })
		tween(accent, 0.3, { BackgroundTransparency = 0 })
		tween(title, 0.3, { TextTransparency = 0 })
		tween(content, 0.3, { TextTransparency = 0.2 })

		local duration = data.Duration or math.clamp(#(data.Content or "") * 0.05 + 3, 3, 10)
		task.wait(duration)

		tween(notif, 0.3, { BackgroundTransparency = 1 })
		tween(notif:FindFirstChildOfClass("UIStroke"), 0.3, { Transparency = 1 })
		tween(accent, 0.3, { BackgroundTransparency = 1 })
		tween(title, 0.3, { TextTransparency = 1 })
		tween(content, 0.3, { TextTransparency = 1 })
		task.wait(0.35)
		notif:Destroy()
	end)
end

