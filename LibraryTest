				waiting = true; btn.Text = "..."
				tween(btn:FindFirstChildOfClass("UIStroke"), 0.15, { Color = Theme.Accent, Transparency = 0 })
			end)
			local conn = UIS.InputBegan:Connect(function(input, processed)
