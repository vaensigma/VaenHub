				TextColor3 = Theme.Text, TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			return { Set = function(_, t, _i, c) lbl.Text = t if c then el.BackgroundColor3 = c end end }
		end

		function Tab:CreateParagraph(d)
			local el = new("Frame", {
				Parent = page, BackgroundColor3 = Theme.Element,
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			}, { corner(7), stroke(Theme.ElementStroke, 0.5), pad(12) })
