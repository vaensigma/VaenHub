					tween(arrow, 0.2, { Rotation = 0 })
					task.wait(0.2); list.Visible = false
				end
			end)
			local proxy = { Type = "Dropdown", Flag = d.Flag, Name = d.Name }
			setmetatable(proxy, { __index = function(_, k) if k == "CurrentOption" then return d.CurrentOption end end })
			function proxy:Set(v)
				if type(v) == "string" then v = { v } end
				d.CurrentOption = v; selLbl.Text = displayText(); rebuild()
				if d.Callback then pcall(d.Callback, d.CurrentOption) end
			end
			function proxy:Refresh(opts) d.Options = opts rebuild() end
			if d.Flag then VaenLib.Flags[d.Flag] = proxy end
			return proxy
		end

