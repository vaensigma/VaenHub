		function Tab:CreateSlider(d)
			d.Range = d.Range or {0, 100}
			d.Increment = d.Increment or 1
			d.CurrentValue = d.CurrentValue or d.Range[1]
			local el = baseEl(52); hoverFx(el)
			new("TextLabel", {
				Parent = el, BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 0, 16),
				Font = Enum.Font.Gotham, Text = d.Name,
				TextColor3 = Theme.Text, TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			local valLbl = new("TextLabel", {
				Parent = el, BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 0, 16),
				Font = Enum.Font.GothamMedium,
				Text = tostring(d.CurrentValue) .. (d.Suffix and (" " .. d.Suffix) or ""),
				TextColor3 = Theme.AccentLight, TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Right,
			})
			local track = new("Frame", {
				Parent = el, BackgroundColor3 = Theme.BgDeep,
				Position = UDim2.new(0, 12, 1, -14), Size = UDim2.new(1, -24, 0, 5),
				BorderSizePixel = 0,
			}, { corner(3) })
			local fill = new("Frame", {
				Parent = track, BackgroundColor3 = Color3.new(1, 1, 1),
				Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0,
			}, { corner(3), phantomGradient(90) })

			local function compute(v, fire)
				v = math.clamp(v, d.Range[1], d.Range[2])
				v = math.floor(v / d.Increment + 0.5) * d.Increment
				if d.Increment < 1 then
					local digits = math.max(0, math.ceil(-math.log10(d.Increment)))
					v = math.floor(v * 10^digits + 0.5) / 10^digits
				end
				local pct = (v - d.Range[1]) / (d.Range[2] - d.Range[1])
				tween(fill, 0.12, { Size = UDim2.new(pct, 0, 1, 0) })
				valLbl.Text = tostring(v) .. (d.Suffix and (" " .. d.Suffix) or "")
				if d.CurrentValue ~= v then
					d.CurrentValue = v
					if fire and d.Callback then pcall(d.Callback, v) end
				end
			end
			compute(d.CurrentValue, false)

			local dragging = false
			local function setFromX(x)
				local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				compute(d.Range[1] + rel * (d.Range[2] - d.Range[1]), true)
			end
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true; setFromX(input.Position.X)
				end
			end)
			UIS.InputChanged:Connect(function(input)
				if not dragging then return end
				if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
					setFromX(input.Position.X)
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
			end)

			local proxy = { Type = "Slider", Flag = d.Flag, Name = d.Name }
			setmetatable(proxy, { __index = function(_, k) if k == "CurrentValue" then return d.CurrentValue end end })
			function proxy:Set(v) compute(v, true) end
			if d.Flag then VaenLib.Flags[d.Flag] = proxy end
			return proxy
		end

