function VaenLib:Notify(data)
	data = data or {}
	task.spawn(function()
		local n = new("Frame", {
			Parent = NotifHolder, BackgroundColor3 = Theme.Notif,
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
		}, { corner(8), stroke(Theme.ElementStroke, 1, 1), pad(12) })

		local bar = new("Frame", {
			Parent = n, BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			Position = UDim2.new(0, -12, 0, 8), Size = UDim2.new(0, 3, 1, -16),
			BorderSizePixel = 0,
		}, { corner(2), phantomGradient(0) })

		local barGlow = new("ImageLabel", {
			Parent = n, BackgroundTransparency = 1,
			Image = "rbxassetid://5028857084",
			ImageColor3 = Theme.AccentGlow, ImageTransparency = 1,
			Position = UDim2.new(0, -20, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.new(0, 40, 0, 60),
		})

		new("UIListLayout", { Parent = n, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })

		local title = new("TextLabel", {
			Parent = n, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 18),
			Font = Enum.Font.GothamSemibold, Text = data.Title or "Notification",
			TextColor3 = Theme.Text, TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, LayoutOrder = 1,
		})
		local content = new("TextLabel", {
			Parent = n, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			Font = Enum.Font.Gotham, Text = data.Content or "",
			TextColor3 = Theme.TextDim, TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
			TextTransparency = 1, LayoutOrder = 2,
		})

		tween(n, 0.35, { BackgroundTransparency = 0.05 })
		tween(n:FindFirstChildOfClass("UIStroke"), 0.35, { Transparency = 0.5 })
		tween(bar, 0.35, { BackgroundTransparency = 0 })
		tween(barGlow, 0.4, { ImageTransparency = 0.6 })
		tween(title, 0.35, { TextTransparency = 0 })
		tween(content, 0.35, { TextTransparency = 0.2 })

		local dur = data.Duration or math.clamp(#(data.Content or "") * 0.04 + 3, 3, 10)
		task.wait(dur)

		tween(n, 0.3, { BackgroundTransparency = 1 })
		tween(n:FindFirstChildOfClass("UIStroke"), 0.3, { Transparency = 1 })
		tween(bar, 0.3, { BackgroundTransparency = 1 })
		tween(barGlow, 0.3, { ImageTransparency = 1 })
		tween(title, 0.3, { TextTransparency = 1 })
		tween(content, 0.3, { TextTransparency = 1 })
		task.wait(0.35)
		n:Destroy()
	end)
end

