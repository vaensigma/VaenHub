			local el = new("Frame", {
				Parent = page, BackgroundColor3 = Theme.Element,
				Size = UDim2.new(1, 0, 0, h or 38),
			}, { corner(7), stroke(Theme.ElementStroke, 0.5) })
			return el
		end
