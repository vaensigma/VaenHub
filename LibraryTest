					tween(el, 0.2, { Size = UDim2.new(1, 0, 0, 38) })
					task.wait(0.2)
					panel.Visible = false
				end
			end)

			if s.Flag then VaenLib.Flags[s.Flag] = s end
			function s:Set(c) s.Color = c refresh() pcall(s.Callback, c) end
			return s
		end

		return Tab
	end

	function Window.ModifyTheme(t)
		if type(t) == "table" then
			for k, v in pairs(t) do
				if SelectedTheme[k] ~= nil then SelectedTheme[k] = v end
			end
			-- Apply (basic — full repaint would be heavier; user can extend)
			Main.BackgroundColor3 = SelectedTheme.Background
			Sidebar.BackgroundColor3 = SelectedTheme.Sidebar
			Topbar.BackgroundColor3 = SelectedTheme.Topbar
		end
	end

	-- =====================================================================
	-- KEYBIND TO SHOW/HIDE
	-- =====================================================================
	local hideKey = settings.ToggleUIKeybind or Enum.KeyCode.K
	if type(hideKey) == "string" then hideKey = Enum.KeyCode[hideKey:upper()] or Enum.KeyCode.K end

	local hideConn
	hideConn = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == hideKey then
			Hidden = not Hidden
			Main.Visible = not Hidden
		end
	end)
	table.insert(keybindConnections, hideConn)

	return Window
end

