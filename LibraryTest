	function VaenLib:LoadConfiguration()
		if not cfgEnabled then return end
		local path = cfgFolder .. "/" .. cfgFile .. ".vaen"
		if not (isfile and safe(isfile, path)) then return end
		local raw = safe(readfile, path); if not raw then return end
		local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if not ok or type(data) ~= "table" then return end
		for flag, val in pairs(data) do
			if VaenLib.Flags[flag] and VaenLib.Flags[flag].Set then
				pcall(function() VaenLib.Flags[flag]:Set(val) end)
			end
		end
	end
	task.spawn(function()
		while not VaenLib._destroyed do
			task.wait(3)
			if cfgEnabled and writefile then
				local data = {}
				for flag, el in pairs(VaenLib.Flags) do
					if el.Type == "ColorPicker" then
						data[flag] = { R = el.Color.R * 255, G = el.Color.G * 255, B = el.Color.B * 255 }
					elseif el.CurrentValue ~= nil then data[flag] = el.CurrentValue
					elseif el.CurrentOption then data[flag] = el.CurrentOption
					elseif el.CurrentKeybind then data[flag] = el.CurrentKeybind end
				end
				pcall(function() writefile(cfgFolder .. "/" .. cfgFile .. ".vaen", HttpService:JSONEncode(data)) end)
			end
		end
	end)
	return Window
end

function VaenLib:SetVisibility() end
function VaenLib:IsVisible() return true end
function VaenLib:Destroy() VaenLib._destroyed = true pcall(function() Gui:Destroy() end) end
function VaenLib:LoadConfiguration() end

return VaenLib
