	closeBtn.MouseButton1Click:Connect(function()
		Hidden = true
		tween(Main, 0.25, { Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(Main.Position.X.Scale, Main.Position.X.Offset + 290, Main.Position.Y.Scale, Main.Position.Y.Offset + 200) })
		task.wait(0.25)
		Main.Visible = false
	end)

