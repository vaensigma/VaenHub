	-- =================== STATE ===================
	local Tabs = {}
	local CurrentTab = nil
	local FirstTab = true

	local function selectTab(tab)
		if CurrentTab == tab then return end
		CurrentTab = tab
		TabTitle.Text = tab.Name

		for _, t in ipairs(Tabs) do
			if t == tab then
				tween(t.Button, 0.2, { BackgroundTransparency = 0, BackgroundColor3 = SelectedTheme.Element })
				tween(t.Indicator, 0.2, { BackgroundTransparency = 0 })
				tween(t.Label, 0.2, { TextColor3 = SelectedTheme.Text })
				t.Page.Visible = true
			else
				tween(t.Button, 0.2, { BackgroundTransparency = 1 })
				tween(t.Indicator, 0.2, { BackgroundTransparency = 1 })
				tween(t.Label, 0.2, { TextColor3 = SelectedTheme.TextDim })
				t.Page.Visible = false
			end
		end
	end

