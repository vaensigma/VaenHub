				Visible = false,
			}, { corner(4), stroke(SelectedTheme.ElementStroke, 0.4) })

			local listLayout = new("UIListLayout", {
				Parent = list,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 2),
			})
			new("UIPadding", { Parent = list, PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) })

			local open = false
			local optionButtons = {}

			local function rebuild()
				for _, b in ipairs(optionButtons) do b:Destroy() end
				optionButtons = {}

				for _, opt in ipairs(s.Options) do
					local b = new("TextButton", {
						Parent = list,
						BackgroundColor3 = SelectedTheme.Element,
						Size = UDim2.new(1, 0, 0, 24),
						Font = Enum.Font.Gotham,
						Text = opt,
						TextColor3 = SelectedTheme.TextDim,
						TextSize = 12,
						AutoButtonColor = false,
					}, { corner(3) })

					local function refreshState()
						if table.find(s.CurrentOption, opt) then
							b.BackgroundColor3 = SelectedTheme.Accent
							b.TextColor3 = SelectedTheme.Text
						else
							b.BackgroundColor3 = SelectedTheme.Element
							b.TextColor3 = SelectedTheme.TextDim
						end
					end
					refreshState()

					b.MouseButton1Click:Connect(function()
						if s.MultipleOptions then
							local idx = table.find(s.CurrentOption, opt)
							if idx then table.remove(s.CurrentOption, idx)
							else table.insert(s.CurrentOption, opt) end
						else
							s.CurrentOption = { opt }
						end
						selectedLbl.Text = displayText()
						for _, ob in ipairs(optionButtons) do
							if table.find(s.CurrentOption, ob.Text) then
								tween(ob, 0.1, { BackgroundColor3 = SelectedTheme.Accent, TextColor3 = SelectedTheme.Text })
							else
								tween(ob, 0.1, { BackgroundColor3 = SelectedTheme.Element, TextColor3 = SelectedTheme.TextDim })
							end
						end
						pcall(s.Callback, s.CurrentOption)
					end)

					table.insert(optionButtons, b)
				end
			end
			rebuild()

			local btn = new("TextButton", {
				Parent = el,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 0, 0, 0),
				Size = UDim2.new(1, 0, 0, 38),
				Text = "",
				AutoButtonColor = false,
			})
			btn.MouseButton1Click:Connect(function()
				open = not open
				if open then
					list.Visible = true
					local h = math.min(#s.Options * 26 + 8, 150)
					tween(el, 0.2, { Size = UDim2.new(1, 0, 0, 42 + h + 6) })
					tween(arrow, 0.2, { Rotation = 180 })
				else
					tween(el, 0.2, { Size = UDim2.new(1, 0, 0, 38) })
					tween(arrow, 0.2, { Rotation = 0 })
					task.wait(0.2)
					list.Visible = false
				end
			end)

			if s.Flag then VaenLib.Flags[s.Flag] = s end
			function s:Set(v)
				if type(v) == "string" then v = { v } end
				s.CurrentOption = v
				selectedLbl.Text = displayText()
				rebuild()
				pcall(s.Callback, s.CurrentOption)
			end
			function s:Refresh(opts)
				s.Options = opts
				rebuild()
			end
			return s
		end

