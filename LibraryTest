-- ═════════════ UTILS ═════════════
local function tween(o, t, p, s, d)
	local i = TweenInfo.new(t or 0.2, s or Enum.EasingStyle.Quart, d or Enum.EasingDirection.Out)
	local tw = TS:Create(o, i, p); tw:Play(); return tw
end
local function new(c, p, ch)
	local i = Instance.new(c)
	if p then for k, v in pairs(p) do i[k] = v end end
	if ch then for _, x in ipairs(ch) do x.Parent = i end end
	return i
end
local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }) end
local function stroke(c, t, th)
	return new("UIStroke", {
		Color = c or Theme.ElementStroke, Transparency = t or 0,
		Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end
local function pad(p)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p),
		PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p),
	})
end
local function phantomGradient(rot)
	return new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.AccentLight),
			ColorSequenceKeypoint.new(0.5, Theme.Accent),
			ColorSequenceKeypoint.new(1, Theme.AccentDeep),
		}),
		Rotation = rot or 0,
	})
end
local function safe(fn, ...) if not fn then return end local ok, r = pcall(fn, ...) if ok then return r end end
local function ensureFolder(p) if isfolder and not safe(isfolder, p) then safe(makefolder, p) end end

