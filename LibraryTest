			local s = el:FindFirstChildOfClass("UIStroke")
			el.MouseEnter:Connect(function()
				tween(el, 0.15, { BackgroundColor3 = Theme.ElementHover })
				if s then tween(s, 0.15, { Color = Theme.Accent, Transparency = 0.6 }) end
			end)
			el.MouseLeave:Connect(function()
				tween(el, 0.15, { BackgroundColor3 = Theme.Element })
				if s then tween(s, 0.15, { Color = Theme.ElementStroke, Transparency = 0.5 }) end
			end)
		end

		function Tab:CreateSection(name)
			local holder = new("Frame", { Parent = page, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24) })
			new("Frame", {
				Parent = holder, BackgroundColor3 = Theme.Accent,
				Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
				Size = UDim2.new(0, 3, 0, 12), BorderSizePixel = 0,
			}, { corner(2), phantomGradient(0) })
			local s = new("TextLabel", {
				Parent = holder, BackgroundTransparency = 1,
				Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -10, 1, 0),
				Font = Enum.Font.GothamBold, Text = name,
				TextColor3 = Theme.Text, TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1,
			})
			tween(s, 0.3, { TextTransparency = 0 })
			return { Set = function(_, v) s.Text = v end }
		end

