	local Tabs, CurrentTab, FirstTab, Minimized, Hidden = {}, nil, true, false, false
	local keybindConns = {}

	local function selectTab(tab)
		if CurrentTab == tab then return end
		CurrentTab = tab
		for _, t in ipairs(Tabs) do
			if t == tab then
				tween(t.Btn, 0.2, { BackgroundTransparency = 0 })
				tween(t.Label, 0.2, { TextColor3 = Theme.Text })
				tween(t.Underline, 0.25, { Size = UDim2.new(1, -16, 0, 2), BackgroundTransparency = 0 })
				t.Page.Visible = true
			else
				tween(t.Btn, 0.2, { BackgroundTransparency = 1 })
				tween(t.Label, 0.2, { TextColor3 = Theme.TextDim })
				tween(t.Underline, 0.2, { Size = UDim2.new(0, 0, 0, 2), BackgroundTransparency = 1 })
				t.Page.Visible = false
			end
		end
	end

	closeBtn.MouseButton1Click:Connect(function()
		Hidden = true
		tween(Main, 0.3, { Size = UDim2.new(0, 0, 0, 0) })
		task.wait(0.3); Main.Visible = false
	end)
	minBtn.MouseButton1Click:Connect(function()
		Minimized = not Minimized
		if Minimized then
			tween(Main, 0.3, { Size = UDim2.new(0, 600, 0, 38) })
			TabBar.Visible = false; Content.Visible = false
		else
			TabBar.Visible = true; Content.Visible = true
			tween(Main, 0.3, { Size = UDim2.new(0, 600, 0, 440) })
		end
	end)

