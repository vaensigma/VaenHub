-- =============================================================================
-- TWEEN HELPERS
-- =============================================================================
local function tween(obj, t, props, style, dir)
	local info = TweenInfo.new(t or 0.25, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
	local tw = TweenService:Create(obj, info, props)
	tw:Play()
	return tw
end

-- =============================================================================
-- INSTANCE HELPER
-- =============================================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	if props then for k, v in pairs(props) do inst[k] = v end end
	if children then for _, c in ipairs(children) do c.Parent = inst end end
	return inst
end

local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r or 6) }) end
local function stroke(c, t, th) return new("UIStroke", { Color = c or SelectedTheme.ElementStroke, Transparency = t or 0, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
local function padding(p) return new("UIPadding", { PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p), PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p) }) end

