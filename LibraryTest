		function Tab:CreateSlider(s)
			s.Range = s.Range or {0, 100}
			s.Increment = s.Increment or 1
			s.CurrentValue = s.CurrentValue or s.Range[1]
			local el = baseElement(50)
			hoverEffect(el)

			new("TextLabel", {
				Parent = el,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 4),
				Size = UDim2.new(1, -24, 0, 16),
				Font = Enum.Font.Gotham,
				Text = s.Name,
				TextColor3 = SelectedTheme.Text,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
			})

			local valueLbl = new("TextLabel", {
				Parent = el,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 4),
				Size = UDim2.new(1, -24, 0, 16),
				Font = Enum.Font.GothamMedium,
				Text = tostring(s.CurrentValue) .. (s.Suffix and (" " .. s.Suffix) or ""),
				TextColor3 = SelectedTheme.Accent,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Right,
			})

			local track = new("Frame", {
				Parent = el,
				BackgroundColor3 = SelectedTheme.Background,
				Position = UDim2.new(0, 12, 1, -14),
				Size = UDim2.new(1, -24, 0, 4),
			}, { corner(2) })

			local fill = new("Frame", {
				Parent = track,
				BackgroundColor3 = SelectedTheme.Accent,
				Size = UDim2.new(0, 0, 1, 0),
			}, { corner(2) })

			local function compute(v)
				v = math.clamp(v, s.Range[1], s.Range[2])
				v = math.floor(v / s.Increment + 0.5) * s.Increment
				local pct = (v - s.Range[1]) / (s.Range[2] - s.Range[1])
				tween(fill, 0.1, { Size = UDim2.new(pct, 0, 1, 0) })
				valueLbl.Text = tostring(v) .. (s.Suffix and (" " .. s.Suffix) or "")
				s.CurrentValue = v
			end
			compute(s.CurrentValue)

			local dragging = false
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					if dragging then
						dragging = false
						pcall(s.Callback, s.CurrentValue)
					end
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if not dragging then return end
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
					compute(s.Range[1] + rel * (s.Range[2] - s.Range[1]))
				end
			end)

			-- Click to jump
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
					compute(s.Range[1] + rel * (s.Range[2] - s.Range[1]))
				end
			end)

			if s.Flag then VaenLib.Flags[s.Flag] = s end
			function s:Set(v) compute(v) pcall(s.Callback, s.CurrentValue) end
			return s
		end

