			local d = new("Frame", {
				Parent = page, BackgroundColor3 = Theme.ElementStroke,
				BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 1),
			})
			tween(d, 0.3, { BackgroundTransparency = 0.3 })
			return { Set = function(_, v) d.Visible = v end }
