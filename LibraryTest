function VaenLib:Destroy()
	rayfieldDestroyed = true
	for _, c in ipairs(keybindConnections) do pcall(function() c:Disconnect() end) end
	VaenGui:Destroy()
end

-- =============================================================================
-- CONFIG LOADING (Rayfield-compatible stub)
-- =============================================================================
function VaenLib:LoadConfiguration()
	if not CEnabled then globalLoaded = true return end
	pcall(function()
		local path = ConfigFolder .. "/" .. CFileName .. Ext
		if isfile and safe(isfile, path) then
			local raw = safe(readfile, path)
			local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
			if ok and type(data) == "table" then
				for flag, value in pairs(data) do
					if VaenLib.Flags[flag] and VaenLib.Flags[flag].Set then
						pcall(function() VaenLib.Flags[flag]:Set(value) end)
					end
				end
			end
		end
	end)
	globalLoaded = true
end

-- Auto-save when flags change
task.spawn(function()
	while not rayfieldDestroyed do
		task.wait(2)
		if CEnabled and globalLoaded and writefile then
			local data = {}
			for flag, el in pairs(VaenLib.Flags) do
				if el.Type == "ColorPicker" then
					data[flag] = { R = el.Color.R * 255, G = el.Color.G * 255, B = el.Color.B * 255 }
				else
					data[flag] = el.CurrentValue or el.CurrentOption or el.CurrentKeybind or el.Color
				end
			end
			pcall(function()
				writefile(ConfigFolder .. "/" .. CFileName .. Ext, HttpService:JSONEncode(data))
			end)
		end
	end
end)

return VaenLib
