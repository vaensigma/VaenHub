				TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1,
			})
			local c = new("TextLabel", {
				Parent = el, BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				Font = Enum.Font.Gotham, Text = d.Content or "",
				TextColor3 = Theme.TextDim, TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LayoutOrder = 2,
			})
			return { Set = function(_, ns) t.Text = ns.Title or t.Text c.Text = ns.Content or c.Text end }
		end

		function Tab:CreateButton(d)
			local el = baseEl(38); hoverFx(el)
			local lbl = new("TextLabel", {
				Parent = el, BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -36, 1, 0),
				Font = Enum.Font.Gotham, Text = d.Name,
